    "truncated": false,
    "sql": "SELECT\n  product__category\n  , COUNT(DISTINCT orders_by_category) AS orders_by_category\nFROM (\n  SELECT\n    products_src_10000.category AS product__category\n    , orders_src_10000.status AS order__status\n    , order_items_src_10000.order_id AS orders_by_category\n  FROM \"olist\".\"main\".\"fct_order_items\" order_items_src_10000\n  LEFT OUTER JOIN\n    \"olist\".\"main\".\"dim_products\" products_src_10000\n  ON\n    order_items_src_10000.product_id = products_src_10000.product_id\n  LEFT OUTER JOIN\n    \"olist\".\"main\".\"fct_orders\" orders_src_10000\n  ON\n    order_items_src_10000.order_id = orders_src_10000.order_id\n) subq_8\nWHERE order__status = 'canceled'\nGROUP BY\n  product__category\nORDER BY product__category",
    "definitions": {
     "orders_by_category": "Orders that contain at least one item of the product category, any status; filter order__status for canceled or delivered ones. An order with items in two categories counts in both, so categories add up to more than all orders. Orders with no items (mostly canceled or unavailable ones) have no category and are not counted."
    }
   }
