    "truncated": false,
    "sql": "SELECT\n  metric_time__year\n  , SUM(payments) AS payments\nFROM (\n  SELECT\n    subq_3.metric_time__year AS metric_time__year\n    , subq_3.payment__payment_type AS payment__payment_type\n    , orders_src_10000.status AS order__status\n    , subq_3.__payments AS payments\n  FROM (\n    SELECT\n      DATE_TRUNC('year', purchased_at) AS metric_time__year\n      , order_id AS order\n      , payment_type AS payment__payment_type\n      , amount AS __payments\n    FROM \"olist\".\"main\".\"fct_payments\" payments_src_10000\n    WHERE DATE_TRUNC('day', purchased_at) BETWEEN '2018-01-01' AND '2018-12-31'\n  ) subq_3\n  LEFT OUTER JOIN\n    \"olist\".\"main\".\"fct_orders\" orders_src_10000\n  ON\n    subq_3.order = orders_src_10000.order_id\n) subq_8\nWHERE (\n  order__status = 'delivered'\n) AND (\n  payment__payment_type = 'voucher'\n)\nGROUP BY\n  metric_time__year\nORDER BY metric_time__year"
