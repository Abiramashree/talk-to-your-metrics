    "sql": "SELECT\n  CAST(SUM(late_orders) AS DOUBLE) / CAST(NULLIF(SUM(delivered_orders_with_date), 0) AS DOUBLE) AS late_delivery_rate\nFROM (\n  SELECT\n    state AS order__state\n    , case when is_late then 1 else 0 end AS late_orders\n    , case when has_delivery then 1 else 0 end AS delivered_orders_with_date\n  FROM \"olist\".\"main\".\"fct_orders\" orders_src_10000\n  WHERE DATE_TRUNC('day', purchased_at) BETWEEN '2018-01-01' AND '2018-12-31'\n) subq_5\nWHERE order__state = 'SP'\nLIMIT 1"
