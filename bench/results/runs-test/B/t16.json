    "truncated": false,
    "sql": "SELECT\n  metric_time__year\n  , CAST(late_orders AS DOUBLE) / CAST(NULLIF(delivered_orders_with_date, 0) AS DOUBLE) AS late_delivery_rate\nFROM (\n  SELECT\n    metric_time__year\n    , SUM(__late_orders) AS late_orders\n    , SUM(__delivered_orders_with_date) AS delivered_orders_with_date\n  FROM (\n    SELECT\n      DATE_TRUNC('year', purchased_at) AS metric_time__year\n      , case when is_late then 1 else 0 end AS __late_orders\n      , case when has_delivery then 1 else 0 end AS __delivered_orders_with_date\n    FROM \"olist\".\"main\".\"fct_orders\" orders_src_10000\n    WHERE DATE_TRUNC('day', purchased_at) BETWEEN '2017-01-01' AND '2017-12-31'\n  ) subq_6\n  GROUP BY\n    metric_time__year\n) subq_8\nORDER BY metric_time__year"
