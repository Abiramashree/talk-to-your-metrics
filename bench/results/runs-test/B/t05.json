    "truncated": false,
    "sql": "SELECT\n  SUM(freight) AS freight\nFROM (\n  SELECT\n    orders_src_10000.status AS order__status\n    , subq_3.__freight AS freight\n  FROM (\n    SELECT\n      order_id AS order\n      , freight AS __freight\n    FROM \"olist\".\"main\".\"fct_order_items\" order_items_src_10000\n    WHERE DATE_TRUNC('day', purchased_at) BETWEEN '2018-01-01' AND '2018-12-31'\n  ) subq_3\n  LEFT OUTER JOIN\n    \"olist\".\"main\".\"fct_orders\" orders_src_10000\n  ON\n    subq_3.order = orders_src_10000.order_id\n) subq_8\nWHERE order__status = 'delivered'"
