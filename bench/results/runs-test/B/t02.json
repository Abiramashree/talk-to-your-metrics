    "truncated": false,
    "sql": "SELECT\n  metric_time__month\n  , SUM(revenue) AS revenue\nFROM (\n  SELECT\n    subq_3.metric_time__month AS metric_time__month\n    , orders_src_10000.status AS order__status\n    , subq_3.__revenue AS revenue\n  FROM (\n    SELECT\n      DATE_TRUNC('month', purchased_at) AS metric_time__month\n      , order_id AS order\n      , price AS __revenue\n    FROM \"olist\".\"main\".\"fct_order_items\" order_items_src_10000\n    WHERE DATE_TRUNC('day', purchased_at) BETWEEN '2018-01-01' AND '2018-06-30'\n  ) subq_3\n  LEFT OUTER JOIN\n    \"olist\".\"main\".\"fct_orders\" orders_src_10000\n  ON\n    subq_3.order = orders_src_10000.order_id\n) subq_8\nWHERE order__status = 'delivered'\nGROUP BY\n  metric_time__month\nORDER BY metric_time__month"
