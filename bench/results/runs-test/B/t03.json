    "sql": "SELECT\n  product__category\n  , SUM(revenue) AS revenue\nFROM (\n  SELECT\n    products_src_10000.category AS product__category\n    , orders_src_10000.status AS order__status\n    , subq_3.__revenue AS revenue\n  FROM (\n    SELECT\n      order_id AS order\n      , product_id AS product\n      , price AS __revenue\n    FROM \"olist\".\"main\".\"fct_order_items\" order_items_src_10000\n    WHERE DATE_TRUNC('day', purchased_at) BETWEEN '2018-01-01' AND '2018-12-31'\n  ) subq_3\n  LEFT OUTER JOIN\n    \"olist\".\"main\".\"dim_products\" products_src_10000\n  ON\n    subq_3.product = products_src_10000.product_id\n  LEFT OUTER JOIN\n    \"olist\".\"main\".\"fct_orders\" orders_src_10000\n  ON\n    subq_3.order = orders_src_10000.order_id\n) subq_10\nWHERE order__status = 'delivered'\nGROUP BY\n  product__category\nORDER BY revenue DESC\nLIMIT 1"
