    "truncated": false,
    "sql": "SELECT\n  metric_time__year\n  , SUM(revenue) AS revenue\nFROM (\n  SELECT\n    subq_3.metric_time__year AS metric_time__year\n    , orders_src_10000.status AS order__status\n    , subq_3.__revenue AS revenue\n  FROM (\n    SELECT\n      DATE_TRUNC('year', purchased_at) AS metric_time__year\n      , order_id AS order\n      , price AS __revenue\n    FROM \"olist\".\"main\".\"fct_order_items\" order_items_src_10000\n    WHERE DATE_TRUNC('day', purchased_at) BETWEEN '2016-01-01' AND '2018-12-31'\n  ) subq_3\n  LEFT OUTER JOIN\n    \"olist\".\"main\".\"fct_orders\" orders_src_10000\n  ON\n    subq_3.order = orders_src_10000.order_id\n) subq_8\nWHERE order__status = 'delivered'\nGROUP BY\n  metric_time__year\nORDER BY metric_time__year"
